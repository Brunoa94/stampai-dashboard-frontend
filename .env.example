# Public origin; endpoint paths already include /api. Never put provider secrets here.
VITE_API_ORIGIN=
# IANA timezone verified against your GA4 property; required for analytics presets.
VITE_GA4_TIMEZONE=

# Server-only credentials for local Vite JWT exchange at localhost:3002/api/auth/login.
# Do not prefix these with VITE_ or expose them through browser code.
# Admin email address used as the login request email field.
ADMIN_USER=
ADMIN_PASSWORD=
