{
  "name": "stampai-dashboard-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "verify:patterns": "node scripts/verify-patterns.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts *.ts *.js *.json index.html && eslint . --fix"
  },
  "dependencies": {
    "@lucide/vue": "^1.55.0",
    "@tanstack/vue-query": "^5.104.1",
    "@unovis/ts": "^1.7.1",
    "@unovis/vue": "^1.7.1",
    "pinia": "^3.0.4",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "2.4.6",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.13"
  }
}
